[Unit]
Description=Create a consistent music-sync state backup
ConditionPathIsDirectory=/srv/music-sync-backups

[Service]
Type=oneshot
User=music-sync
Group=music-sync
ExecStart=/opt/music-sync/current/music-sync maintenance backup --config /etc/music-sync/music-sync.toml --directory /srv/music-sync-backups
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/music-sync-state /srv/music-sync-backups
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
ProtectClock=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictNamespaces=true
