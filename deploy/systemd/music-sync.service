[Unit]
Description=Synchronize the music-sync library
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=music-sync
Group=music-sync
EnvironmentFile=-/etc/music-sync/music-sync.env
ExecStart=/opt/music-sync/current/music-sync service run --trigger timer --config /etc/music-sync/music-sync.toml
TimeoutStartSec=6h
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/music-sync /srv/music /srv/music-playlists
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
ProtectClock=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictNamespaces=true
